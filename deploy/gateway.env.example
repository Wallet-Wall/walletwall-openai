# Replace the origin and lease path after owner authorization.
WALLETWALL_GATEWAY_PUBLIC_ORIGIN=https://walletwall-mcp.invalid
WALLETWALL_GATEWAY_LEASE_FILE=/var/lib/walletwall-mcp/REPLACE_WITH_NEW_APPROVED_LEASE
WALLETWALL_TLS_CERT=/etc/walletwall/tls/current/fullchain.pem
WALLETWALL_TLS_KEY=/etc/walletwall/tls/current/privkey.pem
